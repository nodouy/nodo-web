---
import DotMark from "./DotMark.astro";
import Flecha from "./Flecha.astro";
import { ruta } from "../lib/rutas";

const nav = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios y planes" },
  { href: "/seguridad", label: "Seguridad" },
  { href: "/contacto", label: "Contacto" },
];

// Ruta actual sin la base del sitio, para marcar la página activa.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const actual =
  (Astro.url.pathname.slice(base.length) || "/").replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 border-b border-line bg-base/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href={ruta("/")} class="flex items-center gap-2.5" aria-label="NODO, ir al inicio">
      <DotMark class="text-body" />
      <span class="text-lg font-medium tracking-wide">NODO</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={ruta(item.href)}
            aria-current={actual === item.href ? "page" : undefined}
            class={`text-sm transition-colors hover:text-accent ${
              actual === item.href ? "text-accent" : "text-body"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="js-theme flex size-10 items-center justify-center rounded-full border border-line transition-colors hover:border-accent"
        aria-label="Cambiar entre modo claro y oscuro"
      >
        <svg class="icono-sol" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8.5 1v2M8.5 14v2M1 8.5h2M14 8.5h2M3.2 3.2l1.4 1.4M12.4 12.4l1.4 1.4M13.8 3.2l-1.4 1.4M4.6 12.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <svg class="icono-luna" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13.5 9.5A5.75 5.75 0 0 1 6.5 2.5a5.75 5.75 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
      </button>

      <a
        href={ruta("/formulario")}
        data-ga="cta_comenzar"
        class="btn btn-solid btn-brillo js-pausable hidden px-5! py-2.5! text-sm sm:inline-flex"
      >
        Empezá ahora
        <Flecha />
      </a>

      <button
        type="button"
        class="js-nav-toggle flex size-10 items-center justify-center rounded-full border border-line md:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir el menú"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
          <path d="M1 1h14M1 6h14M1 11h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    hidden
    class="flex flex-col gap-1 border-t border-line px-5 py-4 md:hidden"
    aria-label="Navegación móvil"
  >
    {
      nav.map((item) => (
        <a
          href={ruta(item.href)}
          aria-current={actual === item.href ? "page" : undefined}
          class={`rounded-lg px-3 py-2.5 transition-colors ${
            actual === item.href ? "text-accent" : "text-body"
          }`}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={ruta("/formulario")}
      data-ga="cta_comenzar"
      class="btn btn-solid btn-brillo js-pausable mt-2 justify-center"
    >
      Empezá ahora
      <Flecha />
    </a>
  </nav>
</header>

<style>
  /* El icono del botón de tema muestra el modo al que se puede pasar */
  .icono-sol {
    display: block;
  }
  .icono-luna {
    display: none;
  }
  :global([data-theme="light"]) .icono-sol {
    display: none;
  }
  :global([data-theme="light"]) .icono-luna {
    display: block;
  }
</style>
