---
/**
 * Botón-enlace del sitio. Las acciones principales llevan la flecha
 * diagonal, como en la referencia de marca.
 */
import Flecha from "./Flecha.astro";
import { ruta } from "../lib/rutas";

interface Props {
  href: string;
  variante?: "solid" | "outline";
  flecha?: boolean;
  class?: string;
  externo?: boolean;
  /** Destello periódico: solo para el botón de acción principal. */
  brillo?: boolean;
  /** Evento de GA4 que dispara el clic (data-ga, ver Base.astro). */
  evento?: string;
}

const {
  href,
  variante = "solid",
  flecha = true,
  class: className = "",
  externo = false,
  brillo = false,
  evento,
} = Astro.props;
---

<a
  href={ruta(href)}
  class={`btn ${variante === "solid" ? "btn-solid" : "btn-outline"} ${
    brillo ? "btn-brillo js-pausable" : ""
  } ${className}`}
  {...evento ? { "data-ga": evento } : {}}
  {...externo ? { target: "_blank", rel: "noopener" } : {}}
>
  <slot />
  {flecha && <Flecha />}
</a>
