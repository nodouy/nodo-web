---
/**
 * Bloque de cierre: rojo, a todo el ancho del contenido y alineado a la
 * izquierda, con el botón principal y WhatsApp como alternativa.
 */
import { waLink } from "../data/site";
import Boton from "./Boton.astro";

interface Props {
  titulo: string;
  bajada?: string;
}
const { titulo, bajada } = Astro.props;
---

<section class="reveal relative overflow-hidden rounded-lg bg-block p-7 text-block-contrast md:p-9">
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-1/2 opacity-20"
    style="background-image: radial-gradient(#ffffff 1.5px, transparent 1.5px); background-size: 24px 24px; mask-image: linear-gradient(to left, black, transparent);"
    aria-hidden="true"
  >
  </div>
  <div class="relative flex flex-col items-start gap-3">
    <h2 class="max-w-xl text-2xl font-medium md:text-3xl">{titulo}</h2>
    {bajada && <p class="max-w-xl text-block-contrast/85">{bajada}</p>}
    <div class="mt-3 flex flex-wrap gap-3">
      <Boton
        href="/formulario"
        brillo
        evento="cta_comenzar"
        class="btn-brillo-tinta h-11 bg-white! px-5! py-0! text-[15px] text-ink!"
      >
        Empezá ahora
      </Boton>
      <Boton
        href={waLink}
        externo
        variante="outline"
        class="h-11 border-white/40! px-5! py-0! text-[15px] text-white! hover:border-white!"
      >
        Escribinos por WhatsApp
      </Boton>
    </div>
  </div>
</section>
