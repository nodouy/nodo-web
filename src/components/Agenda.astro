---
/**
 * Bloque de agenda, en el lenguaje del reporte y alineado a la
 * izquierda. En Contacto lleva el calendario embebido (en celular, un
 * botón que abre la página de reservas en pestaña nueva); en el resto,
 * dos botones.
 */
import { site, waLink } from "../data/site";
import { agenda } from "../data/inicio";
import Boton from "./Boton.astro";

interface Props {
  conCalendario?: boolean;
}
const { conCalendario = false } = Astro.props;
---

<section id="agenda" class="reveal scroll-mt-6 rounded-lg bg-raised p-6 md:p-7">
  <h2 class="text-2xl font-medium md:text-3xl">{agenda.titulo}</h2>
  <p class="mt-2 max-w-2xl text-muted">{agenda.bajada}</p>

  {
    conCalendario && site.calendarioUrl ? (
      <>
        <div class="mt-5 hidden overflow-hidden rounded-lg border border-line md:block">
          <iframe
            src={site.calendarioUrl}
            title="Calendario para agendar una reunión con NODO"
            class="h-[38rem] w-full"
            loading="lazy"
          />
        </div>
        <div class="mt-5 flex flex-col items-start gap-3 md:hidden">
          <Boton href={site.calendarioCorto} externo evento="agenda_click" class="h-11 px-5! py-0! text-[15px]">
            {agenda.botonCelular}
          </Boton>
          <Boton href={waLink} externo variante="outline" flecha={false} class="h-11 px-5! py-0! text-[15px]">
            {agenda.botonWhatsapp}
          </Boton>
        </div>
      </>
    ) : (
      <div class="mt-5 flex flex-wrap gap-3">
        <Boton href="/contacto#agenda" evento="agenda_click" class="h-11 px-5! py-0! text-[15px]">
          {agenda.botonAgenda}
        </Boton>
        <Boton href={waLink} externo variante="outline" flecha={false} class="h-11 px-5! py-0! text-[15px]">
          {agenda.botonWhatsapp}
        </Boton>
      </div>
    )
  }
</section>
