---
/**
 * Sección de agenda, en dos modos:
 *
 * - Sin calendario (Inicio): título, bajada y dos botones — uno a la
 *   página de Contacto y el de WhatsApp. El calendario embebido no va
 *   en Inicio: es un elemento visual de Google ajeno al sistema de
 *   diseño, pesa, y en celular se comporta mal.
 * - Con calendario (Contacto): el recuadro embebido en escritorio; en
 *   celular, un botón que abre la página de reservas en una pestaña
 *   nueva, porque el embebido queda demasiado alto en pantallas chicas.
 */
import { site, waLink } from "../data/site";
import { agenda } from "../data/inicio";
import Boton from "./Boton.astro";

interface Props {
  conCalendario?: boolean;
}
const { conCalendario = false } = Astro.props;
---

<section id="agenda" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 md:py-24">
  <div class="reveal mx-auto max-w-xl text-center">
    <h2 class="text-3xl md:text-4xl">{agenda.titulo}</h2>
    <p class="mt-3 text-muted">{agenda.bajada}</p>
  </div>

  {
    conCalendario && site.calendarioUrl ? (
      <>
        <div class="reveal mt-8 hidden overflow-hidden rounded-3xl border border-line bg-raised md:block">
          <iframe
            src={site.calendarioUrl}
            title="Calendario para agendar una reunión con NODO"
            class="h-[38rem] w-full"
            loading="lazy"
          />
        </div>
        <div class="reveal mt-8 flex flex-col items-center gap-3 md:hidden">
          <Boton href={site.calendarioCorto} externo evento="agenda_click">
            {agenda.botonCelular}
          </Boton>
          <Boton href={waLink} externo variante="outline" flecha={false}>
            {agenda.botonWhatsapp}
          </Boton>
        </div>
      </>
    ) : (
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3">
        <Boton href="/contacto#agenda" evento="agenda_click">
          {agenda.botonAgenda}
        </Boton>
        <Boton href={waLink} externo variante="outline" flecha={false}>
          {agenda.botonWhatsapp}
        </Boton>
      </div>
    )
  }
</section>
