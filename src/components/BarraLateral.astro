---
/**
 * Navegación del reporte: barra lateral fija en escritorio (logo de
 * puntos + NODO, las cinco secciones como ícono + etiqueta y el botón
 * de tema al pie) y barra inferior fija en celular.
 *
 * El resaltado de la sección activa lleva transition:name, así con las
 * View Transitions se desliza de una sección a otra al navegar.
 */
import DotMark from "./DotMark.astro";
import { ruta } from "../lib/rutas";

const secciones = [
  {
    href: "/",
    etiqueta: "Inicio",
    icono: "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z",
  },
  {
    href: "/servicios",
    etiqueta: "Servicios y planes",
    icono: "M5 20V11M12 20V4M19 20v-6",
  },
  {
    href: "/seguridad",
    etiqueta: "Seguridad",
    icono: "M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z",
  },
  {
    href: "/preguntas",
    etiqueta: "Preguntas",
    icono: "M9.1 9.2a3 3 0 1 1 4.2 3c-.9.5-1.3 1-1.3 1.9M12 17.4h.01M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z",
  },
  {
    href: "/contacto",
    etiqueta: "Contacto",
    icono: "M4 5h16v11H9l-5 4z",
  },
];

// Ruta actual sin la base del sitio, para marcar la sección activa.
// El formulario cuenta como parte del recorrido de Inicio.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const actual =
  (Astro.url.pathname.slice(base.length) || "/").replace(/\/$/, "") || "/";
const activa = (href: string) =>
  href === "/" ? actual === "/" || actual === "/formulario" : actual === href;
---

{/* Escritorio: barra lateral fija, con el botón de tema al pie */}
<aside
  class="sticky top-0 hidden h-screen w-24 shrink-0 flex-col items-center gap-2 overflow-y-auto border-r border-line px-2 py-7 md:flex"
  aria-label="Secciones"
>
  <a href={ruta("/")} class="flex flex-col items-center gap-2 pb-5 pt-1" aria-label="NODO, ir al inicio">
    <DotMark class="logo-vivo text-body" />
    <span class="text-[15px] font-medium tracking-[0.06em]">NODO</span>
  </a>
  {
    secciones.map((s) => (
      <a
        href={ruta(s.href)}
        aria-current={activa(s.href) ? "page" : undefined}
        class={`relative flex w-full flex-col items-center gap-1.5 rounded-xl px-1 py-3 text-center text-[12px] leading-tight transition-colors ${
          activa(s.href) ? "text-accent" : "text-muted hover:text-body"
        }`}
      >
        {activa(s.href) && (
          <span
            class="absolute inset-0 rounded-xl bg-raised"
            transition:name="nav-activa"
            aria-hidden="true"
          />
        )}
        <svg
          class="relative"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={s.icono} />
        </svg>
        <span class="relative">{s.etiqueta}</span>
      </a>
    ))
  }
  <button
    type="button"
    class="js-theme mt-auto flex size-10 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-body"
    aria-label="Cambiar entre modo claro y oscuro"
  >
    <svg class="icono-sol" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M8.5 1v2M8.5 14v2M1 8.5h2M14 8.5h2M3.2 3.2l1.4 1.4M12.4 12.4l1.4 1.4M13.8 3.2l-1.4 1.4M4.6 12.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <svg class="icono-luna" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M13.5 9.5A5.75 5.75 0 0 1 6.5 2.5a5.75 5.75 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    </svg>
  </button>
</aside>

{/* Celular: barra inferior fija, con el tema como sexto ítem */}
<nav
  class="fixed inset-x-0 bottom-0 z-50 flex border-t border-line bg-base/95 backdrop-blur-md md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
  aria-label="Secciones"
>
  {
    secciones.map((s) => (
      <a
        href={ruta(s.href)}
        aria-current={activa(s.href) ? "page" : undefined}
        class={`flex min-w-0 flex-1 flex-col items-center gap-1 px-0.5 py-2.5 text-center text-[10px] leading-tight transition-colors ${
          activa(s.href) ? "text-accent" : "text-muted"
        }`}
      >
        <svg
          width="21"
          height="21"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={s.icono} />
        </svg>
        <span class="w-full truncate">{s.etiqueta}</span>
      </a>
    ))
  }
  <button
    type="button"
    class="js-theme flex min-w-0 flex-1 flex-col items-center gap-1 px-0.5 py-2.5 text-center text-[10px] leading-tight text-muted"
    aria-label="Cambiar entre modo claro y oscuro"
  >
    <svg class="icono-sol" width="21" height="21" viewBox="0 0 17 17" fill="none" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M8.5 1v2M8.5 14v2M1 8.5h2M14 8.5h2M3.2 3.2l1.4 1.4M12.4 12.4l1.4 1.4M13.8 3.2l-1.4 1.4M4.6 12.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <svg class="icono-luna" width="21" height="21" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M13.5 9.5A5.75 5.75 0 0 1 6.5 2.5a5.75 5.75 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    </svg>
    <span class="w-full truncate">Tema</span>
  </button>
</nav>
