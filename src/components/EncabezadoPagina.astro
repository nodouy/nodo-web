---
/**
 * Encabezado de cada página del reporte: solo el nombre de la sección.
 * El botón "Empezá ahora" vive acá pero, en el Inicio, arranca oculto y
 * aparece recién cuando el del bloque principal sale de pantalla (ver
 * Base.astro). El botón de tema vive al pie de la barra lateral.
 */
import Flecha from "./Flecha.astro";
import { ruta } from "../lib/rutas";

interface Props {
  seccion: string;
  /** En el Inicio, el CTA aparece recién al scrollear. */
  ctaDiferido?: boolean;
}
const { seccion, ctaDiferido = false } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-4xl font-medium tracking-tight md:text-[35px] md:leading-[42px]">
    {seccion}
  </h1>
  <a
    href={ruta("/formulario")}
    data-ga="cta_comenzar"
    data-diferido={ctaDiferido ? "1" : undefined}
    class={`js-cta-encabezado btn btn-rojo btn-brillo js-pausable h-11 px-5! py-0! text-[15px] md:text-[14px] ${
      ctaDiferido ? "cta-oculto" : ""
    }`}
  >
    Empezá ahora
    <Flecha />
  </a>
</div>
