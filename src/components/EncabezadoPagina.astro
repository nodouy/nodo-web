---
/**
 * Encabezado de cada página del reporte: el nombre de la sección en
 * grande, la etiqueta opcional, el botón de tema y el botón principal
 * "Empezá ahora".
 */
import Flecha from "./Flecha.astro";
import { ruta } from "../lib/rutas";

interface Props {
  seccion: string;
  etiqueta?: string;
}
const { seccion, etiqueta } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-4xl font-medium tracking-tight md:text-[44px] md:leading-[52px]">
    {seccion}
  </h1>
  <div class="flex flex-wrap items-center gap-3">
    {
      etiqueta && (
        <span class="pill hidden min-h-11 border-0 bg-raised px-4 text-sm text-muted lg:inline-flex">
          {etiqueta}
        </span>
      )
    }
    <button
      type="button"
      class="js-theme flex size-11 items-center justify-center rounded-full border border-line transition-colors hover:border-accent"
      aria-label="Cambiar entre modo claro y oscuro"
    >
      <svg class="icono-sol" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
        <circle cx="8.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M8.5 1v2M8.5 14v2M1 8.5h2M14 8.5h2M3.2 3.2l1.4 1.4M12.4 12.4l1.4 1.4M13.8 3.2l-1.4 1.4M4.6 12.4l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <svg class="icono-luna" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13.5 9.5A5.75 5.75 0 0 1 6.5 2.5a5.75 5.75 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
      </svg>
    </button>
    <a
      href={ruta("/formulario")}
      data-ga="cta_comenzar"
      class="btn btn-rojo btn-brillo js-pausable h-11 px-5! py-0! text-base"
    >
      Empezá ahora
      <Flecha />
    </a>
  </div>
</div>
