---
/**
 * La notebook del sitio, según la referencia del cliente: vista de
 * frente, pantalla 16:10 de proporción fija (nunca se estira ni se
 * aplasta), marco negro fino con cámara y base plateada con muesca.
 * Dibujada con HTML/CSS, sin imágenes. La pantalla sigue el tema
 * claro/oscuro; el slot es el reporte de ejemplo de cada plan.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`notebook ${className}`}>
  <div class="notebook-pantalla">
    <div class="notebook-camara" aria-hidden="true"></div>
    <div class="notebook-display">
      <slot />
    </div>
  </div>
  <div class="notebook-borde" aria-hidden="true"></div>
  <div class="notebook-base" aria-hidden="true"><div></div></div>
</div>
