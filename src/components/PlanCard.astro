---
/**
 * Tarjeta resumida de un plan para la página de inicio. Interactiva:
 * levita y acentúa el borde al pasar el mouse. El Full se destaca: es
 * el que carga los tres diferenciales exclusivos.
 */
import { etiquetaExclusivos, type Plan } from "../data/planes";
import Flecha from "./Flecha.astro";
import MiniGrilla from "./MiniGrilla.astro";
import { ruta } from "../lib/rutas";

interface Props {
  plan: Plan;
  /** Preguntas de los planes anteriores: cada plan incluye al anterior. */
  heredadas?: string[];
  class?: string;
}
const { plan, heredadas = [], class: className = "" } = Astro.props;
---

<article
  class={`card-i relative flex flex-col gap-4 overflow-hidden rounded-3xl border bg-raised p-6 ${
    plan.destacado ? "border-accent" : "border-line"
  } ${className}`}
>
  <div class="relative flex items-start justify-between gap-2">
    <h3 class="text-xl">{plan.nombre}</h3>
    <span class="pill border border-line bg-raised text-muted">{plan.metafora}</span>
  </div>

  {/* Preguntas acumulativas: las heredadas chicas y en gris, la propia
      del plan destacada. justify-end alinea las tres tarjetas. */}
  <div class="relative flex flex-col justify-end gap-0.5 md:min-h-[4.6rem]">
    {
      heredadas.length > 0 && (
        <p class="text-sm text-muted">{heredadas.join(" + ")} +</p>
      )
    }
    <p class="text-2xl text-accent">{plan.pregunta}</p>
  </div>
  <p class="relative text-sm leading-relaxed text-muted md:text-[14px]">{plan.resumen}</p>

  {/* Cuánto cubre el plan, dicho en el lenguaje de la marca */}
  <MiniGrilla rojos={plan.cobertura} class="relative" />

  <p class="relative mt-auto border-t border-line pt-4">
    <span class="panel-num text-3xl">{plan.precio}</span>
    <span class="block text-sm text-muted">{plan.modalidad}</span>
  </p>

  {
    plan.exclusivos && (
      <div class="relative border-t border-line pt-4">
        <h4 class="text-xs font-medium uppercase tracking-wide text-accent">
          {etiquetaExclusivos}
        </h4>
        <ul class="mt-2.5 flex flex-col gap-2 text-sm">
          {plan.exclusivos.map((e) => (
            <li class="flex items-center gap-2.5">
              <span class="size-2 shrink-0 rounded-full bg-block" aria-hidden="true" />
              {e.titulo}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <a
    href={ruta(`/servicios#${plan.id}`)}
    class="flex items-center gap-1.5 text-sm text-accent"
  >
    Ver en detalle
    <Flecha />
    {/* extiende el área clickeable a toda la tarjeta */}
    <span class="absolute inset-0" aria-hidden="true"></span>
  </a>
</article>
