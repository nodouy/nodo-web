---
import Base from "../layouts/Base.astro";
import Boton from "../components/Boton.astro";
import { waLink, mailtoLink, site } from "../data/site";
import { portada } from "../data/inicio";
import { ruta } from "../lib/rutas";

const ctaHablar = portada.ctaHablar;
import {
  encabezado,
  secciones,
  totalPreguntas,
  estados,
  notaPrivacidad,
} from "../data/formulario";

const claseCampo =
  "w-full rounded-xl border border-line bg-raised px-4 py-3 text-body placeholder:text-muted";
---

<Base
  titulo="Formulario de inicio — NODO"
  seccion="Formulario de inicio"
  descripcion="Contanos de tu negocio en menos de 5 minutos. Sin costo ni compromiso: nos sirve para preparar una reunión informativa a tu medida."
>
  <section class="mx-auto max-w-3xl px-5 pb-8 pt-14 md:pt-20">
    <div class="reveal">
      <span class="pill border border-line text-muted">{encabezado.etiqueta}</span>
      <h1 class="mt-5 text-4xl leading-[1.1] tracking-tight md:text-5xl">
        {encabezado.titulo}
      </h1>
      <p class="mt-3 text-xl text-accent">{encabezado.eslogan}</p>
      <p class="mt-4 leading-relaxed text-muted">{encabezado.bajada}</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        encabezado.puntos.map((p, i) => (
          <article class={`reveal reveal-d${i} rounded-2xl border border-line bg-raised p-5`}>
            <h2 class="text-sm font-medium">{p.titulo}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.texto}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-5 text-sm leading-relaxed text-muted">{encabezado.principio}</p>
    <p class="mt-2 text-sm text-muted">{encabezado.notaObligatorias}</p>

    {/* Opción secundaria, de menor peso, para quien prefiere conversar antes */}
    <a
      href={ruta("/contacto#agenda")}
      data-ga="agenda_click"
      class="enlace-flecha mt-5 flex w-fit items-center gap-1.5 text-sm text-muted underline-offset-4 transition-colors hover:text-accent"
    >
      {ctaHablar}
      <svg class="flecha" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-16 md:pb-24">
    {/* Barra de progreso: acompaña mientras se responde */}
    <div
      class="sticky top-[4.2rem] z-30 rounded-full border border-line bg-raised/90 px-4 py-2.5 backdrop-blur-md"
    >
      <div class="flex items-center gap-3">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-line">
          <div
            class="js-progreso h-full origin-left rounded-full bg-accent transition-transform duration-300"
            style="transform: scaleX(0)"
          >
          </div>
        </div>
        <span class="js-progreso-texto panel-num shrink-0 text-xs text-muted">
          0 de {totalPreguntas} respondidas
        </span>
      </div>
    </div>

    <form class="js-form-inicio mt-8 flex flex-col gap-12" novalidate>
      {/* Campo trampa anti-spam: las personas no lo ven ni lo tocan */}
      <label class="trampa" aria-hidden="true">
        No completes este campo
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </label>

      {
        secciones.map((seccion) => (
          <fieldset class="flex flex-col gap-7">
            <legend class="flex items-baseline gap-4 border-b border-line pb-4">
              <span class="panel-num text-sm text-accent">{seccion.numero}</span>
              <span class="text-2xl">{seccion.titulo}</span>
            </legend>

            {seccion.preguntas.map((p) => {
              const nombre = `${p.numero} · ${p.etiqueta}`;
              const idBase = `p${p.numero}`;
              return (
                <div
                  class="flex flex-col gap-2"
                  data-pregunta
                  data-obligatoria={p.obligatoria ? "si" : undefined}
                  data-tipo={p.tipo}
                >
                  <label
                    class="font-medium"
                    for={
                      p.tipo === "unica" || p.tipo === "multiple"
                        ? undefined
                        : idBase
                    }
                    id={`${idBase}-etiqueta`}
                  >
                    <span class="panel-num mr-2 text-sm text-muted">{p.numero}</span>
                    {p.etiqueta}
                    {p.obligatoria && <span class="text-accent"> *</span>}
                  </label>

                  {p.ayuda && <p class="text-sm text-muted">{p.ayuda}</p>}

                  {p.tipo === "texto" && (
                    <input id={idBase} name={nombre} type="text" class={claseCampo} />
                  )}

                  {p.tipo === "correo" && (
                    <input
                      id={idBase}
                      name={nombre}
                      type="email"
                      autocomplete="email"
                      class={claseCampo}
                    />
                  )}

                  {p.tipo === "telefono" && (
                    <input
                      id={idBase}
                      name={nombre}
                      type="tel"
                      inputmode="tel"
                      autocomplete="tel"
                      class={claseCampo}
                    />
                  )}

                  {p.tipo === "parrafo" && (
                    <textarea id={idBase} name={nombre} rows="4" class={claseCampo} />
                  )}

                  {(p.tipo === "unica" || p.tipo === "multiple") && (
                    <div
                      class="grid gap-2 sm:grid-cols-2"
                      role={p.tipo === "unica" ? "radiogroup" : "group"}
                      aria-labelledby={`${idBase}-etiqueta`}
                    >
                      {p.opciones?.map((opcion) => (
                        <label class="opcion">
                          <input
                            type={p.tipo === "unica" ? "radio" : "checkbox"}
                            name={nombre}
                            value={opcion}
                          />
                          {opcion}
                        </label>
                      ))}
                    </div>
                  )}

                  {p.detalleOtro && (
                    <input
                      type="text"
                      name={`${p.numero}b · Otro (detalle)`}
                      class={`${claseCampo} sm:max-w-sm`}
                      placeholder="Si marcaste «Otro», contanos cuál"
                      aria-label={`${p.etiqueta} — detalle si marcaste Otro`}
                    />
                  )}

                  <p class="error-campo hidden" data-error aria-live="polite" />
                </div>
              );
            })}
          </fieldset>
        ))
      }

      <div class="flex flex-col gap-4">
        <p
          class="js-error-envio hidden rounded-2xl border border-accent p-5 text-sm leading-relaxed"
          role="alert"
        >
          {estados.errorTexto}
          <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
            <a href={waLink} target="_blank" rel="noopener" class="text-accent underline">
              WhatsApp
            </a>
            <a href={mailtoLink} class="text-accent underline">
              {site.correo.direccion}
            </a>
          </span>
        </p>

        <button type="submit" class="btn btn-solid btn-brillo js-pausable w-fit">
          <span class="js-boton-texto">{estados.enviar}</span>
          <svg class="flecha" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        {/* Nota de privacidad */}
        <p class="text-sm leading-relaxed text-muted">
          {notaPrivacidad.texto}{" "}
          <a href={ruta(notaPrivacidad.enlaceHref)} class="text-accent underline">
            {notaPrivacidad.enlaceTexto}
          </a>
        </p>
      </div>
    </form>

    {/* Pantalla de confirmación: reemplaza al formulario al enviar bien */}
    <div class="js-exito mt-8 hidden" tabindex="-1">
      <div class="rounded-3xl border border-line bg-raised p-8 text-center">
        <h2 class="text-2xl md:text-3xl">{estados.exitoTitulo}</h2>
        <p class="mx-auto mt-3 max-w-md leading-relaxed text-muted">
          {estados.exitoTexto}
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Boton href="/contacto#agenda" evento="agenda_click">Agendá la reunión</Boton>
          <Boton href={waLink} externo variante="outline" flecha={false}>
            Escribinos por WhatsApp
          </Boton>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { enviarFormulario } from "../scripts/envio";

  // Con View Transitions los módulos corren una sola vez: la
  // inicialización va en astro:page-load y se saltea si esta página
  // no tiene el formulario o ya quedó vinculado.
  document.addEventListener("astro:page-load", iniciarFormularioInicio);

  function iniciarFormularioInicio() {
  const form = document.querySelector<HTMLFormElement>(".js-form-inicio");
  if (!form || form.dataset.listo === "1") return;
  form.dataset.listo = "1";
  const preguntas = [...document.querySelectorAll<HTMLElement>("[data-pregunta]")];
  const barra = document.querySelector<HTMLElement>(".js-progreso");
  const barraTexto = document.querySelector<HTMLElement>(".js-progreso-texto");

  function camposDe(pregunta: HTMLElement) {
    return [
      ...pregunta.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input, textarea",
      ),
    ].filter((c) => !c.name.includes("Otro (detalle)"));
  }

  function respondida(pregunta: HTMLElement): boolean {
    for (const campo of camposDe(pregunta)) {
      if (campo instanceof HTMLInputElement && (campo.type === "radio" || campo.type === "checkbox")) {
        if (campo.checked) return true;
      } else if (campo.value.trim() !== "") {
        return true;
      }
    }
    return false;
  }

  function actualizarProgreso() {
    const total = preguntas.length;
    const listas = preguntas.filter(respondida).length;
    if (barra) barra.style.transform = `scaleX(${total ? listas / total : 0})`;
    if (barraTexto) barraTexto.textContent = `${listas} de ${total} respondidas`;
  }

  form?.addEventListener("input", actualizarProgreso);
  form?.addEventListener("change", actualizarProgreso);

  function marcarError(pregunta: HTMLElement, mensaje: string) {
    const aviso = pregunta.querySelector<HTMLElement>("[data-error]");
    if (aviso) {
      aviso.textContent = mensaje;
      aviso.classList.remove("hidden");
    }
    camposDe(pregunta).forEach((c) => c.setAttribute("aria-invalid", "true"));
  }

  function limpiarError(pregunta: HTMLElement) {
    const aviso = pregunta.querySelector<HTMLElement>("[data-error]");
    if (aviso) {
      aviso.textContent = "";
      aviso.classList.add("hidden");
    }
    camposDe(pregunta).forEach((c) => c.removeAttribute("aria-invalid"));
  }

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    // Anti-spam: si el campo trampa está marcado, no se envía nada.
    const trampa = form.querySelector<HTMLInputElement>('[name="botcheck"]');
    if (trampa?.checked) return;

    // Validación con mensajes junto a cada pregunta.
    let primeraConError: HTMLElement | null = null;
    for (const pregunta of preguntas) {
      limpiarError(pregunta);
      const obligatoria = pregunta.dataset.obligatoria === "si";
      const tipo = pregunta.dataset.tipo;

      if (obligatoria && !respondida(pregunta)) {
        marcarError(pregunta, "Esta respuesta es obligatoria.");
        primeraConError ??= pregunta;
        continue;
      }

      if (tipo === "correo") {
        const campo = pregunta.querySelector<HTMLInputElement>("input[type=email]");
        if (campo && campo.value.trim() !== "" && !campo.checkValidity()) {
          marcarError(pregunta, "Revisá que el correo esté bien escrito.");
          primeraConError ??= pregunta;
        }
      }
    }

    if (primeraConError) {
      primeraConError.scrollIntoView({ behavior: "smooth", block: "center" });
      primeraConError.querySelector<HTMLElement>("input, textarea")?.focus({ preventScroll: true });
      return;
    }

    // Armar los campos legibles para el correo.
    const datos = new FormData(form);
    const campos: Record<string, string> = {};
    for (const [clave, valor] of datos.entries()) {
      if (clave === "botcheck") continue;
      const texto = String(valor).trim();
      if (texto === "") continue;
      campos[clave] = campos[clave] ? `${campos[clave]}, ${texto}` : texto;
    }
    campos["subject"] = `Formulario de inicio — ${campos["04 · Nombre de tu negocio o emprendimiento"] ?? "nuevo envío"}`;
    campos["from_name"] = "Web NODO";

    // Estado: enviando.
    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const botonTexto = form.querySelector<HTMLElement>(".js-boton-texto");
    const textoOriginal = botonTexto?.textContent ?? "";
    const errorEnvio = document.querySelector<HTMLElement>(".js-error-envio");
    errorEnvio?.classList.add("hidden");
    if (boton) {
      boton.disabled = true;
      boton.setAttribute("aria-busy", "true");
    }
    if (botonTexto) botonTexto.textContent = "Enviando…";

    const resultado = await enviarFormulario(campos);

    if (resultado.ok) {
      // Medición: envío del formulario de inicio completado.
      const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
      if (typeof w.gtag === "function") {
        w.gtag("event", "formulario_enviado", { pagina: location.pathname });
      }
      const exito = document.querySelector<HTMLElement>(".js-exito");
      form.hidden = true;
      exito?.classList.remove("hidden");
      exito?.scrollIntoView({ behavior: "smooth", block: "center" });
      exito?.focus({ preventScroll: true });
    } else {
      // Nada de lo escrito se pierde: el formulario queda como está.
      if (boton) {
        boton.disabled = false;
        boton.removeAttribute("aria-busy");
      }
      if (botonTexto) botonTexto.textContent = textoOriginal;
      errorEnvio?.classList.remove("hidden");
      errorEnvio?.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });
  }
</script>
