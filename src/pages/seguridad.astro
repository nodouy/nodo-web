---
import Base from "../layouts/Base.astro";
import CtaFinal from "../components/CtaFinal.astro";
import {
  intro,
  acuerdo,
  contrato,
  decision,
  herramientas,
  cierre,
} from "../data/seguridad";
---

<Base
  titulo="Seguridad y confidencialidad — NODO"
  seccion="Seguridad"
  descripcion="Qué firmamos antes de ver tus datos, con qué herramientas trabajamos y qué reglas seguimos con tu información."
>
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <p class="text-sm text-muted">{intro.etiqueta}</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-medium leading-tight tracking-tight md:text-4xl">
      {intro.titulo}
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-muted">{intro.bajada}</p>
  </section>

  <div class="flex flex-wrap gap-5">
    {
      [acuerdo, contrato, decision].map((bloque, i) => (
        <section class={`reveal reveal-d${i} min-w-0 flex-[1_1_300px] rounded-lg bg-raised p-6`}>
          <h2 class="text-[22px] font-medium leading-7">{bloque.titulo}</h2>
          {bloque.parrafos.map((p) => (
            <p class="mt-3 text-sm leading-relaxed text-muted">{p}</p>
          ))}
        </section>
      ))
    }
  </div>

  <h2 class="mt-5 text-2xl font-medium md:text-3xl">
    {herramientas.titulo}
    <span class="text-lg font-normal text-muted md:text-xl">/3</span>
  </h2>
  <p class="-mt-3 max-w-2xl text-muted">{herramientas.bajada}</p>

  {
    herramientas.grupos.map((grupo) => (
      <section class="reveal rounded-lg bg-raised p-6 md:p-7">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-[22px] font-medium">{grupo.titulo}</h3>
          <span class="panel-num text-sm text-muted">{grupo.herramientas}</span>
        </div>
        {grupo.parrafos.map((p) => (
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{p}</p>
        ))}
        {"destacado" in grupo && grupo.destacado && (
          <p class="mt-4 w-fit rounded-lg bg-block px-4 py-3 text-sm font-medium text-block-contrast">
            {grupo.destacado}
          </p>
        )}
      </section>
    ))
  }

  <CtaFinal titulo={cierre.titulo} bajada={cierre.bajada} />
</Base>
