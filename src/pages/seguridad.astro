---
import Base from "../layouts/Base.astro";
import CtaFinal from "../components/CtaFinal.astro";
import {
  intro,
  acuerdo,
  contrato,
  decision,
  herramientas,
  cierre,
} from "../data/seguridad";
---

<Base
  titulo="Seguridad y confidencialidad — NODO"
  seccion="Seguridad"
  descripcion="Qué firmamos antes de ver tus datos, con qué herramientas trabajamos y qué reglas seguimos con tu información."
>
  <section class="mx-auto max-w-6xl px-5 pb-8 pt-14 md:pt-20">
    <div class="reveal">
      <span class="pill border border-line text-muted">{intro.etiqueta}</span>
      <h1 class="mt-5 max-w-2xl text-4xl leading-[1.1] tracking-tight md:text-5xl">
        {intro.titulo}
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{intro.bajada}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="grid gap-4 md:grid-cols-3">
      {
        [acuerdo, contrato, decision].map((bloque, i) => (
          <article class={`reveal reveal-d${i} rounded-3xl border border-line bg-raised p-7`}>
            <h2 class="text-xl">{bloque.titulo}</h2>
            {bloque.parrafos.map((p) => (
              <p class="mt-3 text-sm leading-relaxed text-muted">{p}</p>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="reveal max-w-xl">
      <h2 class="text-3xl md:text-4xl">{herramientas.titulo}</h2>
      <p class="mt-3 text-muted">{herramientas.bajada}</p>
    </div>

    <div class="mt-9 flex flex-col gap-4">
      {
        herramientas.grupos.map((grupo) => (
          <article class="reveal rounded-3xl border border-line bg-raised p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-xl">{grupo.titulo}</h3>
              <span class="panel-num text-sm text-muted">{grupo.herramientas}</span>
            </div>
            {grupo.parrafos.map((p) => (
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">{p}</p>
            ))}
            {"destacado" in grupo && grupo.destacado && (
              <p class="mt-4 w-fit rounded-xl bg-block px-4 py-3 text-sm font-medium text-block-contrast">
                {grupo.destacado}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <CtaFinal titulo={cierre.titulo} bajada={cierre.bajada} />
</Base>
