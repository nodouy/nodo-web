---
import Base from "../layouts/Base.astro";
import EncabezadoSeccion from "../components/EncabezadoSeccion.astro";
import TarjetaGiro from "../components/TarjetaGiro.astro";
import CintaHerramientas from "../components/CintaHerramientas.astro";
import CtaFinal from "../components/CtaFinal.astro";
import {
  intro,
  encabezado,
  acuerdo,
  contrato,
  decision,
  herramientas,
  cierre,
} from "../data/seguridad";

// Tarjetas giratorias de confianza: lo firmado y el principio de marca.
// El texto largo original de cada una queda completo bajo "Ver más"
// hasta que el cliente apruebe el recorte definitivo.
const confianza = [
  {
    ...acuerdo,
    icono:
      "M7 2h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM14 2v4h4M9.3 13.5l1.9 1.9 3.5-3.9",
  },
  {
    ...contrato,
    icono:
      "M7 2h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM14 2v4h4M9.5 12h5M9.5 16h5",
  },
  {
    ...decision,
    icono: "M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5 20a7 7 0 0 1 14 0",
  },
];

// Grupos de herramientas, con el mismo formato de tarjeta giratoria.
const iconosGrupos = [
  "M12 8.5c4.1 0 7.5-1.2 7.5-2.75S16.1 3 12 3 4.5 4.2 4.5 5.75 7.9 8.5 12 8.5zM4.5 5.75V12c0 1.55 3.4 2.75 7.5 2.75s7.5-1.2 7.5-2.75V5.75M4.5 12v6.25C4.5 19.8 7.9 21 12 21s7.5-1.2 7.5-2.75V12",
  "M13 2 5 13.5h6L11 22l8-12h-6z",
  "M4 20l1.2-4.2L16.4 4.6a2 2 0 0 1 2.9 2.9L8.2 18.8 4 20z",
];
---

<Base
  titulo="Seguridad y confidencialidad — NODO"
  seccion="Seguridad"
  descripcion="Qué firmamos antes de ver tus datos, con qué herramientas trabajamos y qué reglas seguimos con tu información."
>
  <EncabezadoSeccion
    frase={encabezado.frase}
    destacada={encabezado.destacada}
    variante="seguridad"
    verMas
  >
    <p>{intro.bajada}</p>
  </EncabezadoSeccion>

  <div class="grid gap-5 md:grid-cols-3">
    {
      confianza.map((tarjeta, i) => (
        <div class={`reveal reveal-d${i} flex min-w-0 flex-col gap-2`}>
          <TarjetaGiro
            titulo={tarjeta.titulo}
            dorso={tarjeta.dorso}
            icono={tarjeta.icono}
            class="flex-1"
          />
          <details class="group px-1">
            <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
              Ver más
              <svg class="transition-transform duration-200 group-open:rotate-45" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="mt-2 flex flex-col gap-2 text-sm leading-relaxed text-muted md:text-[14px]">
              {tarjeta.parrafos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        </div>
      ))
    }
  </div>

  <CintaHerramientas />

  <h2 class="mt-5 text-2xl font-medium md:text-3xl">
    {herramientas.titulo}
    <span class="text-lg font-normal text-muted md:text-xl">/3</span>
  </h2>
  <p class="-mt-3 max-w-2xl text-muted">{herramientas.bajada}</p>

  <div class="grid gap-5 md:grid-cols-3">
    {
      herramientas.grupos.map((grupo, i) => (
        <div class={`reveal reveal-d${i} flex min-w-0 flex-col gap-2`}>
          <TarjetaGiro
            titulo={grupo.titulo}
            dorso={grupo.dorso}
            icono={iconosGrupos[i]}
            subtitulo={grupo.herramientas}
            class="flex-1"
          />
          <details class="group px-1">
            <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
              Ver más
              <svg class="transition-transform duration-200 group-open:rotate-45" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="mt-2 flex flex-col gap-2 text-sm leading-relaxed text-muted md:text-[14px]">
              {grupo.parrafos.map((p) => (
                <p>{p}</p>
              ))}
              {"destacado" in grupo && grupo.destacado && (
                <p class="mt-1 w-fit rounded-lg bg-block px-4 py-3 font-medium text-block-contrast">
                  {grupo.destacado}
                </p>
              )}
            </div>
          </details>
        </div>
      ))
    }
  </div>

  <CtaFinal titulo={cierre.titulo} bajada={cierre.bajada} />
</Base>
