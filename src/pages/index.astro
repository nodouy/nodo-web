---
import Base from "../layouts/Base.astro";
import Flecha from "../components/Flecha.astro";
import { waLink } from "../data/site";
import {
  portada,
  teSuena,
  comoFunciona,
  graficoInicio,
  indicadores,
  bloqueFormulario,
} from "../data/inicio";
import { planes, etiquetaExclusivos } from "../data/planes";
import { ruta } from "../lib/rutas";

const altoMax = Math.max(...graficoInicio.barras.map((b) => b.alto));
---

<Base
  titulo="NODO — Análisis de datos para pymes y emprendimientos de Uruguay"
  seccion="Inicio"
  etiqueta={portada.etiqueta}
>
  {/* 1-2. Bloque principal + un solo gráfico */}
  <div class="flex flex-wrap gap-5">
    <section
      class="reveal relative flex min-w-0 flex-[2_1_520px] flex-col items-start gap-5 rounded-lg bg-raised p-7 md:p-9"
    >
      <p class="relative text-sm text-muted">{portada.rotulo}</p>
      <h2
        class="relative text-5xl font-medium leading-none tracking-tight md:text-[68px]"
      >
        {portada.titulo}
        <span class="text-accent">{portada.tituloAcento}</span>
      </h2>
      <p class="relative max-w-[560px] text-lg leading-relaxed text-muted md:text-[19px] md:leading-[31px]">
        {portada.bajada}
        <span class="font-medium text-accent">{portada.bajadaAcento}</span>
      </p>
      <div class="relative flex flex-wrap gap-3">
        <a
          href={ruta("/formulario")}
          data-ga="cta_comenzar"
          class="btn btn-rojo btn-brillo js-pausable h-11 px-5! py-0! text-[15px]"
        >
          {portada.ctaPrincipal}
          <Flecha />
        </a>
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="btn btn-outline h-11 bg-base px-5! py-0! text-[15px]"
        >
          {portada.ctaWhatsapp}
        </a>
      </div>
      <a
        href={ruta("/contacto#agenda")}
        data-ga="agenda_click"
        class="enlace-flecha relative flex min-h-11 items-center gap-1.5 text-[15px] text-muted transition-colors hover:text-accent"
      >
        {portada.ctaHablar}
        <Flecha />
      </a>
    </section>

    <section
      class="reveal reveal-d1 flex min-h-[400px] min-w-0 flex-[1_1_300px] flex-col overflow-hidden rounded-lg bg-raised"
    >
      <div class="flex flex-col items-start gap-3.5 p-6 pb-0">
        <h2 class="text-sm">{graficoInicio.titulo}</h2>
        <p class="flex items-baseline gap-2">
          <span class="panel-num text-4xl font-medium leading-none md:text-[44px]">
            <span class="js-contador" data-valor={graficoInicio.valor}>{graficoInicio.valor}</span>
          </span>
          <span class="text-sm text-muted">{graficoInicio.sufijo}</span>
        </p>
        <span class="pill bg-body text-xs" style="color: var(--bg)">
          Ejemplo con datos ficticios
        </span>
      </div>
      <div class="rep-barras mt-auto flex items-end gap-[3px] pt-5">
        {
          graficoInicio.barras.map((b) => (
            <div
              class={`rep-bar flex items-end justify-center pb-3 text-[13px] ${b.hot ? "rep-bar--hot" : ""}`}
              style={`height:${Math.round((b.alto / altoMax) * 215)}px`}
            >
              <span class={b.hot ? "text-white" : "text-inv-muted"}>{b.mes}</span>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  {/* 3. Indicadores en píldora */}
  <div class="flex flex-wrap gap-5">
    {
      indicadores.map((k, i) => (
        <a
          href={ruta(k.href)}
          aria-label={k.aria}
          class={`card-i reveal reveal-d${i} flex min-w-0 flex-[1_1_300px] items-center justify-between gap-4 rounded-[80px] py-4 pl-8 pr-5 ${
            k.oscuro ? "bg-inv text-inv-contra" : "bg-raised"
          }`}
        >
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="text-[13px]">{k.etiqueta}</span>
            <span class="panel-num text-[28px] font-medium leading-[1.05]">
              {k.contadores.length === 2 ? (
                <>
                  <span class="js-contador" data-valor={k.contadores[0]}>{k.contadores[0]}</span>
                  {" a "}
                  <span class="js-contador" data-valor={k.contadores[1]}>{k.contadores[1]}</span>
                </>
              ) : k.contadores.length === 1 ? (
                <>
                  <span class="js-contador" data-valor={k.contadores[0]}>{k.contadores[0]}</span>
                  {" USD"}
                </>
              ) : (
                k.valor
              )}
            </span>
            <span class={`text-[13px] ${k.oscuro ? "text-inv-muted" : "text-muted"}`}>
              {k.sub}
            </span>
          </span>
          <span
            class={`flex size-10 shrink-0 items-center justify-center rounded-full ${
              k.oscuro ? "bg-inv-contra text-inv" : "bg-body"
            }`}
            style={k.oscuro ? undefined : "color: var(--bg)"}
            aria-hidden="true"
          >
            <Flecha />
          </span>
        </a>
      ))
    }
  </div>

  {/* 4. Nuestros planes */}
  <h2 class="mt-5 text-2xl font-medium md:text-3xl">
    Nuestros planes <span class="text-lg font-normal text-muted md:text-xl">/3</span>
  </h2>
  <div class="flex flex-wrap gap-5">
    {/* Bloque rojo del formulario, con la escalera coral */}
    <section
      class="card-i reveal relative flex min-w-0 flex-[1_1_280px] flex-col gap-3 overflow-hidden rounded-lg bg-block p-6 text-block-contrast"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 200 200"
        preserveAspectRatio="none"
        class="absolute bottom-0 right-0 h-[42%] w-[46%]"
      >
        <polygon
          points="0,200 0,150 50,150 50,100 100,100 100,50 150,50 150,0 200,0 200,200"
          fill="#FF9D73"></polygon>
      </svg>
      <h3 class="relative text-[22px] font-medium leading-7">
        {bloqueFormulario.titulo}
      </h3>
      <p class="relative text-[15px] leading-6">{bloqueFormulario.texto}</p>
      <a
        href={ruta("/formulario")}
        data-ga="cta_comenzar"
        class="relative mt-auto flex h-12 items-center justify-between gap-3 rounded-full bg-white px-5 pt-0 text-[15px] text-ink"
      >
        {bloqueFormulario.boton}
        <Flecha />
      </a>
    </section>

    {/* Tarjetas de plan con preguntas acumuladas; el Full, invertido */}
    {
      planes.map((plan, i) => {
        const inv = Boolean(plan.destacado);
        const heredadas = planes.slice(0, i).map((x) => x.pregunta);
        return (
          <section
            class={`card-i reveal reveal-d${i} flex min-w-0 flex-[1_1_260px] flex-col items-start gap-3 rounded-lg p-6 ${
              inv ? "bg-inv text-inv-contra" : "bg-raised"
            }`}
          >
            <span
              class={`pill ${
                plan.id === "pro"
                  ? "bg-block text-block-contrast"
                  : inv
                    ? "bg-inv-contra text-inv"
                    : "bg-body"
              }`}
              style={plan.id === "standard" ? "color: var(--bg)" : undefined}
            >
              {plan.metafora}
            </span>
            <h3 class="text-[22px] font-medium leading-7">{plan.nombre}</h3>
            <div class="flex flex-col gap-1">
              {heredadas.map((q) => (
                <p class={`text-[15px] ${inv ? "text-inv-muted" : "text-muted"}`}>{q}</p>
              ))}
              <p class={`text-[20px] leading-tight ${inv ? "text-inv-accent" : "text-accent"}`}>
                {plan.pregunta}
              </p>
            </div>
            <p class={`text-[15px] leading-relaxed ${inv ? "text-inv-muted" : "text-muted"}`}>
              {plan.resumen}
            </p>
            {plan.exclusivos && (
              <div class="flex flex-col gap-1.5 text-[15px]">
                <p class={`text-xs uppercase tracking-[0.08em] ${inv ? "text-inv-accent" : "text-accent"}`}>
                  {etiquetaExclusivos}
                </p>
                {plan.exclusivos.map((e) => (
                  <p>{e.titulo}</p>
                ))}
              </div>
            )}
            <p
              class={`mt-auto flex w-full flex-wrap items-baseline gap-x-2.5 gap-y-1 border-t pt-4 ${
                inv ? "border-inv-line" : "border-line"
              }`}
            >
              <span class="panel-num text-[26px] font-medium">{plan.precio}</span>
              <span class={`text-sm ${inv ? "text-inv-muted" : "text-muted"}`}>
                {plan.modalidad}
              </span>
            </p>
          </section>
        );
      })
    }
  </div>

  {/* 5. ¿Cómo funciona? */}
  <h2 id="como-funciona" class="mt-5 scroll-mt-6 text-2xl font-medium md:text-3xl">
    {comoFunciona.titulo}
    <span class="text-lg font-normal text-muted md:text-xl">{comoFunciona.contador}</span>
  </h2>
  <div class="fichas-pasos flex flex-wrap gap-5">
    {
      comoFunciona.pasos.map((p, i) => (
        <section
          tabindex="0"
          class={`ficha-paso js-pausable reveal reveal-d${i % 4} flex min-w-0 flex-[1_1_200px] flex-col gap-3 rounded-lg bg-raised p-6`}
        >
          <div class="avance" aria-hidden="true">
            <div style={`width:${(i + 1) * 20}%; --d:${i * 120}ms; --bd:${i * 0.9}s`} />
          </div>
          <p class="paso-num panel-num text-[40px] font-medium leading-none transition-colors">
            0{i + 1}
          </p>
          <h3 class="text-lg font-medium leading-6">{p.titulo}</h3>
          <p class="text-[15px] leading-[23px] text-muted">{p.texto}</p>
        </section>
      ))
    }
  </div>

  {/* 6. Lo que ganás con tus datos ordenados */}
  <h2 class="mt-5 text-2xl font-medium md:text-3xl">
    {teSuena.titulo} <span class="text-lg font-normal text-muted md:text-xl">/3</span>
  </h2>
  <div class="flex flex-wrap gap-5">
    {
      teSuena.situaciones.map((s, i) => (
        <section class={`card-i reveal reveal-d${i} flex min-w-0 flex-[1_1_300px] flex-col gap-2.5 rounded-lg bg-raised p-7`}>
          <p class="panel-num text-sm text-accent">0{i + 1}</p>
          <h3 class="text-[22px] font-medium leading-7">{s.titulo}</h3>
          <p class="text-base leading-relaxed text-muted">{s.texto}</p>
        </section>
      ))
    }
  </div>
</Base>
