---
import Base from "../layouts/Base.astro";
import Boton from "../components/Boton.astro";
import Laptop from "../components/Laptop.astro";
import MiniGrilla from "../components/MiniGrilla.astro";
import PanelPlan from "../components/PanelPlan.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { planes, formasDePago, notaFactura } from "../data/planes";
import { plazoEntrega, site } from "../data/site";
import {
  intro,
  recorrido,
  detallePlanes,
  queRecibis,
  sinPowerBi,
  sinPowerBiOnline,
  plazoYPagos,
  arranque,
  formatos,
  cierre,
} from "../data/servicios";

const tipos = ["standard", "pro", "full"] as const;

// El recuadro con acceso en línea incluido se activa recién cuando el
// circuito esté probado de punta a punta (ver site.flags.accesoEnLinea).
const bloquePowerBi = site.flags.accesoEnLinea ? sinPowerBiOnline : sinPowerBi;
---

<Base
  titulo="Servicios y planes — NODO"
  seccion="Servicios y planes"
  descripcion="Tres planes que responden tres preguntas: qué pasó, cómo vengo y qué me conviene hacer. Reportes claros a partir de los datos que ya tenés."
>
  {/* El problema y la solución */}
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <p class="text-sm text-muted">Resumen</p>
    <h2 class="mt-3 max-w-prose text-3xl font-medium leading-tight tracking-tight md:text-4xl">
      {intro.titulo}
    </h2>
    {
      intro.parrafos.map((p, i) => (
        <p
          class={`mt-4 max-w-prose leading-relaxed ${
            i === 1 ? "font-medium" : "text-muted"
          }`}
        >
          {p}
        </p>
      ))
    }
  </section>

  {/* Los tres planes en detalle, cada uno con su laptop */}
  <h2 class="mt-5 text-2xl font-medium md:text-3xl">
    {recorrido.titulo} <span class="text-lg font-normal text-muted md:text-xl">/3</span>
  </h2>
  <p class="-mt-3 max-w-2xl text-muted">{recorrido.bajada}</p>

  {
    planes.map((plan, i) => (
      <section
        id={plan.id}
        class="reveal grid scroll-mt-6 items-center gap-8 rounded-lg bg-raised p-6 md:grid-cols-2 md:p-7"
      >
        <div class={i % 2 === 1 ? "md:order-2" : ""}>
          <div class="flex flex-wrap items-center gap-3">
            <h3 class="text-[22px] font-medium md:text-[18px]">{plan.nombre}</h3>
            <span class="pill border border-line text-muted">{plan.metafora}</span>
          </div>
          {i > 0 && (
            <p class="mt-2 text-[15px] text-muted">
              {planes
                .slice(0, i)
                .map((x) => x.pregunta)
                .join(" + ")}{" "}
              +
            </p>
          )}
          <p class={`${i > 0 ? "mt-1" : "mt-2"} text-2xl text-accent`}>{plan.pregunta}</p>
          <p class="mt-3 leading-relaxed text-muted">{plan.resumen}</p>

          <MiniGrilla rojos={plan.cobertura} class="mt-4" />

          <p class="mt-5">
            <span class="panel-num text-[26px] font-medium md:text-[21px]">{plan.precio}</span>
            <span class="ml-2 text-sm text-muted">{plan.modalidad}</span>
          </p>

          <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
            {detallePlanes.incluyeTitulo}
          </h4>
          <ul class="mt-2.5 flex flex-col gap-2 text-sm">
            {plan.incluye.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>

          <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
            {queRecibis.titulo}
          </h4>
          <ul class="mt-2.5 flex flex-col gap-2 text-sm">
            {(queRecibis.porPlan[plan.id] ?? []).map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
          {plan.id === "standard" && (
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted md:text-[14px]">
              {queRecibis.notaStandard}
            </p>
          )}

          {plan.exclusivos && (
            <div class="mt-5 rounded-lg border border-accent p-5">
              <h4 class="text-sm font-medium uppercase tracking-wide text-accent">
                {detallePlanes.exclusivosTitulo}
              </h4>
              <p class="mt-1 text-sm text-muted">{detallePlanes.exclusivosBajada}</p>
              <ul class="mt-3 flex flex-col gap-3 text-sm">
                {plan.exclusivos.map((e) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-2 shrink-0 rounded-full bg-block" aria-hidden="true" />
                    <span>
                      <span class="font-medium">{e.titulo}.</span>{" "}
                      <span class="text-muted">{e.detalle}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {plan.noIncluye.length > 0 && (
            <>
              <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
                {detallePlanes.noIncluyeTitulo}
              </h4>
              <ul class="mt-2.5 flex flex-col gap-2 text-sm text-muted">
                {plan.noIncluye.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gris/60" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>

        <div class={`w-full max-w-[600px] ${i % 2 === 1 ? "md:order-1" : ""}`}>
          <Laptop>
            <PanelPlan tipo={tipos[i]} />
          </Laptop>
        </div>
      </section>
    ))
  }

  {/* ¿Y si no tengo Power BI? — una sola vez en la página */}
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <h2 class="text-2xl font-medium">{bloquePowerBi.titulo}</h2>
    {
      bloquePowerBi.parrafos.map((p) => (
        <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted md:text-[14px]">{p}</p>
      ))
    }
  </section>

  {/* Plazo y formas de pago */}
  <div class="flex flex-wrap gap-5">
    <section class="reveal min-w-0 flex-[1_1_300px] rounded-lg bg-raised p-6 md:p-7">
      <h2 class="text-[22px] font-medium md:text-[18px]">{plazoYPagos.plazoTitulo}</h2>
      <p class="mt-3 text-2xl text-accent">{plazoEntrega}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted md:text-[14px]">
        El plazo corre desde que recibimos tus datos y el acuerdo está firmado.
        Corresponde a la primera entrega del plan Standard; en Pro y Full es la
        entrega inicial, y después el reporte se actualiza todos los meses.
      </p>
    </section>
    <section class="reveal reveal-d1 min-w-0 flex-[1_1_300px] rounded-lg bg-raised p-6 md:p-7">
      <h2 class="text-[22px] font-medium md:text-[18px]">{plazoYPagos.pagosTitulo}</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {
          formasDePago.map((f) => (
            <li class="flex items-center gap-2.5">
              <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {f}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-muted">{notaFactura}</p>
    </section>
  </div>

  {/* Qué necesitamos para arrancar */}
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <h2 class="text-2xl font-medium md:text-3xl">{arranque.titulo}</h2>
    {
      arranque.parrafos.map((p) => (
        <p class="mt-4 max-w-prose leading-relaxed text-muted">{p}</p>
      ))
    }
    <div class="mt-6">
      <Boton href={arranque.botonHref} brillo evento="cta_comenzar" class="h-11 px-5! py-0! text-[15px]">
        {arranque.boton}
      </Boton>
    </div>
  </section>

  {/* ¿Con qué formatos trabajamos? — contesta la objeción "¿pueden
      trabajar con lo que yo tengo?"; por eso va acá y no en Seguridad */}
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <h2 class="text-2xl font-medium md:text-3xl">{formatos.titulo}</h2>
    <p class="mt-3 max-w-prose leading-relaxed text-muted">{formatos.intro}</p>
    <ul class="mt-5 grid max-w-3xl gap-x-8 gap-y-2.5 text-sm md:grid-cols-2">
      {
        formatos.lista.map((item, i) => (
          <li class="reveal flex items-start gap-2.5" style={`transition-delay:${i * 60}ms`}>
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 max-w-prose text-sm leading-relaxed text-muted md:text-[14px]">{formatos.notaOtros}</p>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted md:text-[14px]">{formatos.notaConexiones}</p>
  </section>

  <CtaFinal titulo={cierre.titulo} bajada={cierre.bajada} />
</Base>
