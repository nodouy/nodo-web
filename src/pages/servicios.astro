---
import Base from "../layouts/Base.astro";
import Boton from "../components/Boton.astro";
import Laptop from "../components/Laptop.astro";
import MiniGrilla from "../components/MiniGrilla.astro";
import PanelPlan from "../components/PanelPlan.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { planes, formasDePago, notaFactura } from "../data/planes";
import { plazoEntrega, site } from "../data/site";
import {
  intro,
  recorrido,
  detallePlanes,
  queRecibis,
  sinPowerBi,
  sinPowerBiOnline,
  plazoYPagos,
  arranque,
  formatos,
  cierre,
} from "../data/servicios";

const tipos = ["standard", "pro", "full"] as const;

// El recuadro con acceso en línea incluido se activa recién cuando el
// circuito esté probado de punta a punta (ver site.flags.accesoEnLinea).
const bloquePowerBi = site.flags.accesoEnLinea ? sinPowerBiOnline : sinPowerBi;
---

<Base
  titulo="Servicios y planes — NODO"
  seccion="Servicios y planes"
  descripcion="Tres planes que responden tres preguntas: qué pasó, cómo vengo y qué me conviene hacer. Reportes claros a partir de los datos que ya tenés."
>
  {/* Introducción: el problema y la solución */}
  <section class="mx-auto max-w-6xl px-5 pb-8 pt-14 md:pt-20">
    <div class="reveal">
      <span class="pill border border-line text-muted">{intro.etiqueta}</span>
      <h1 class="mt-5 max-w-2xl text-4xl leading-[1.1] tracking-tight md:text-5xl">
        {intro.titulo}
      </h1>
      {
        intro.parrafos.map((p) => (
          <p class="mt-4 max-w-2xl leading-relaxed text-muted">{p}</p>
        ))
      }
    </div>
  </section>

  {/* Los tres planes en detalle, cada uno con su laptop */}
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="reveal max-w-xl">
      <h2 class="text-3xl md:text-4xl">{recorrido.titulo}</h2>
      <p class="mt-3 text-muted">{recorrido.bajada}</p>
    </div>

    <div class="mt-10 flex flex-col gap-16 md:gap-20">
      {
        planes.map((plan, i) => (
          <article
            id={plan.id}
            class="grid scroll-mt-24 items-center gap-8 md:grid-cols-2 md:gap-12"
          >
            <div class={`reveal ${i % 2 === 1 ? "md:order-2" : ""}`}>
              <div class="flex items-center gap-3">
                <h3 class="text-2xl">{plan.nombre}</h3>
                <span class="pill border border-line text-muted">{plan.metafora}</span>
              </div>
              {/* Preguntas acumulativas: cada plan incluye al anterior */}
              {i > 0 && (
                <p class="mt-2 text-sm text-muted">
                  {planes
                    .slice(0, i)
                    .map((x) => x.pregunta)
                    .join(" + ")}{" "}
                  +
                </p>
              )}
              <p class={`${i > 0 ? "mt-1" : "mt-2"} text-3xl text-accent`}>
                {plan.pregunta}
              </p>
              <p class="mt-3 leading-relaxed text-muted">{plan.resumen}</p>

              {/* Cuánto cubre el plan, dicho en el lenguaje de la marca */}
              <MiniGrilla rojos={plan.cobertura} class="mt-4" />

              <p class="mt-5">
                <span class="panel-num text-3xl">{plan.precio}</span>
                <span class="ml-2 text-sm text-muted">{plan.modalidad}</span>
              </p>

              <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
                {detallePlanes.incluyeTitulo}
              </h4>
              <ul class="mt-2.5 flex flex-col gap-2 text-sm">
                {plan.incluye.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>

              <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
                {queRecibis.titulo}
              </h4>
              <ul class="mt-2.5 flex flex-col gap-2 text-sm">
                {(queRecibis.porPlan[plan.id] ?? []).map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
              {plan.id === "standard" && (
                <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
                  {queRecibis.notaStandard}
                </p>
              )}

              {plan.exclusivos && (
                <div class="mt-5 rounded-2xl border border-accent p-5">
                  <h4 class="text-sm font-medium uppercase tracking-wide text-accent">
                    {detallePlanes.exclusivosTitulo}
                  </h4>
                  <p class="mt-1 text-sm text-muted">{detallePlanes.exclusivosBajada}</p>
                  <ul class="mt-3 flex flex-col gap-3 text-sm">
                    {plan.exclusivos.map((e) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1.5 size-2 shrink-0 rounded-full bg-block" aria-hidden="true" />
                        <span>
                          <span class="font-medium">{e.titulo}.</span>{" "}
                          <span class="text-muted">{e.detalle}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {plan.noIncluye.length > 0 && (
                <>
                  <h4 class="mt-6 text-sm font-medium uppercase tracking-wide text-muted">
                    {detallePlanes.noIncluyeTitulo}
                  </h4>
                  <ul class="mt-2.5 flex flex-col gap-2 text-sm text-muted">
                    {plan.noIncluye.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gris/60" aria-hidden="true" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>

            <div class={`reveal reveal-d1 ${i % 2 === 1 ? "md:order-1" : ""}`}>
              <Laptop>
                <PanelPlan tipo={tipos[i]} />
              </Laptop>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ¿Y si no tengo Power BI? — una sola vez en la página */}
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="reveal max-w-3xl rounded-3xl border border-line bg-raised p-7">
      <h2 class="text-2xl">{bloquePowerBi.titulo}</h2>
      {
        bloquePowerBi.parrafos.map((p) => (
          <p class="mt-3 text-sm leading-relaxed text-muted">{p}</p>
        ))
      }
    </div>
  </section>

  {/* Plazo y formas de pago */}
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="reveal rounded-3xl border border-line bg-raised p-7">
        <h2 class="text-2xl">{plazoYPagos.plazoTitulo}</h2>
        <p class="mt-3 text-2xl text-accent">{plazoEntrega}</p>
        <p class="mt-2 text-sm text-muted">
          El plazo corre desde que recibimos tus datos y el acuerdo está firmado.
          Corresponde a la primera entrega del plan Standard; en Pro y Full es la
          entrega inicial, y después el reporte se actualiza todos los meses.
        </p>
      </div>
      <div class="reveal reveal-d1 rounded-3xl border border-line bg-raised p-7">
        <h2 class="text-2xl">{plazoYPagos.pagosTitulo}</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            formasDePago.map((f) => (
              <li class="flex items-center gap-2.5">
                <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {f}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-muted">{notaFactura}</p>
      </div>
    </div>
  </section>

  {/* Qué necesitamos para arrancar */}
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl md:text-4xl">{arranque.titulo}</h2>
      {
        arranque.parrafos.map((p) => (
          <p class="mt-4 leading-relaxed text-muted">{p}</p>
        ))
      }
      <div class="mt-6">
        <Boton href={arranque.botonHref} brillo evento="cta_comenzar">
          {arranque.boton}
        </Boton>
      </div>
    </div>
  </section>

  {/* ¿Con qué formatos trabajamos? — contesta la objeción "¿pueden
      trabajar con lo que yo tengo?"; por eso va acá y no en Seguridad */}
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl md:text-4xl">{formatos.titulo}</h2>
      <p class="mt-4 leading-relaxed text-muted">{formatos.intro}</p>
    </div>
    <ul class="mt-6 grid max-w-2xl gap-x-8 gap-y-2.5 text-sm md:grid-cols-2">
      {
        formatos.lista.map((item, i) => (
          <li
            class="reveal flex items-start gap-2.5"
            style={`transition-delay:${i * 60}ms`}
          >
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
    <div class="reveal mt-6 max-w-2xl">
      <p class="text-sm leading-relaxed text-muted">{formatos.notaOtros}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">{formatos.notaConexiones}</p>
    </div>
  </section>

  <CtaFinal titulo={cierre.titulo} bajada={cierre.bajada} />
</Base>
