---
import Base from "../layouts/Base.astro";
import Boton from "../components/Boton.astro";
import Agenda from "../components/Agenda.astro";
import { site, waLink, mailtoLink } from "../data/site";
import { intro, canales, formulario, ubicacion } from "../data/contacto";
---

<Base
  titulo="Contacto — NODO"
  seccion="Contacto"
  descripcion="Escribinos por WhatsApp o correo, o agendá una reunión informativa sin compromiso."
>
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <p class="text-sm text-muted">{intro.etiqueta}</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-medium leading-tight tracking-tight md:text-4xl">
      {intro.titulo}
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-muted">{intro.bajada}</p>
  </section>

  <div class="flex flex-wrap gap-5">
      <article class="card-i reveal flex min-w-0 flex-[1_1_280px] flex-col items-start gap-3 rounded-lg bg-raised p-6">
        <h2 class="text-xl">{canales.whatsappTitulo}</h2>
        <p class="flex-1 text-sm text-muted">{canales.whatsappTexto}</p>
        <Boton href={waLink} externo class="w-fit px-5! py-2.5! text-sm">
          Abrir WhatsApp
        </Boton>
      </article>

      <article class="card-i reveal reveal-d1 flex min-w-0 flex-[1_1_280px] flex-col items-start gap-3 rounded-lg bg-raised p-6">
        <h2 class="text-xl">{canales.correoTitulo}</h2>
        <p class="flex-1 text-sm text-muted">{canales.correoTexto}</p>
        {/* El texto visible del botón es la dirección: si el enlace no
            abre el programa de correo, igual se puede leer y copiar. */}
        <Boton href={mailtoLink} variante="outline" flecha={false} class="w-fit px-5! py-2.5! text-sm">
          {site.correo.direccion}
        </Boton>
      </article>

      <article class="card-i reveal reveal-d2 flex min-w-0 flex-[1_1_280px] flex-col items-start gap-3 rounded-lg bg-raised p-6">
        <h2 class="text-xl">{canales.redesTitulo}</h2>
        <p class="flex-1 text-sm text-muted">{canales.redesTexto}</p>
        <div class="flex flex-wrap gap-2">
          {
            site.redes.instagram && (
              <Boton href={site.redes.instagram} externo variante="outline" flecha={false} class="px-5! py-2.5! text-sm">
                Instagram
              </Boton>
            )
          }
          {
            site.redes.linkedin && (
              <Boton href={site.redes.linkedin} externo variante="outline" flecha={false} class="px-5! py-2.5! text-sm">
                LinkedIn
              </Boton>
            )
          }
          {
            !site.redes.instagram && !site.redes.linkedin && (
              <p class="text-sm text-muted">Muy pronto por acá.</p>
            )
          }
        </div>
      </article>
  </div>

  {/* Formulario simple de contacto, dentro de su bloque */}
  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <h2 class="text-2xl font-medium md:text-3xl">{formulario.titulo}</h2>
    <p class="mt-2 max-w-2xl text-muted">{formulario.bajada}</p>

    <form class="js-form-contacto mt-6 flex max-w-2xl flex-col gap-5" novalidate>
      {/* Campo trampa anti-spam: las personas no lo ven ni lo tocan */}
      <label class="trampa" aria-hidden="true">
        No completes este campo
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      </label>

      <div class="flex flex-col gap-1.5">
        <label for="nombre" class="text-sm font-medium">{formulario.campos.nombre}</label>
        <input
          id="nombre"
          name="Nombre"
          type="text"
          required
          autocomplete="name"
          class="rounded-lg border border-line bg-base px-4 py-3 text-body placeholder:text-muted"
        />
        <p class="error-campo hidden" data-error aria-live="polite"></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="rubro" class="text-sm font-medium">{formulario.campos.rubro}</label>
        <input
          id="rubro"
          name="Rubro"
          type="text"
          required
          class="rounded-lg border border-line bg-base px-4 py-3 text-body placeholder:text-muted"
        />
        <p class="error-campo hidden" data-error aria-live="polite"></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="mensaje" class="text-sm font-medium">{formulario.campos.mensaje}</label>
        <textarea
          id="mensaje"
          name="Mensaje"
          rows="5"
          required
          class="rounded-lg border border-line bg-base px-4 py-3 text-body placeholder:text-muted"
        ></textarea>
        <p class="error-campo hidden" data-error aria-live="polite"></p>
      </div>

      <p
        class="js-error-envio hidden rounded-2xl border border-accent p-5 text-sm leading-relaxed"
        role="alert"
      >
        {formulario.errorTexto}
        <span class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          <a href={waLink} target="_blank" rel="noopener" class="text-accent underline">
            WhatsApp
          </a>
          <a href={mailtoLink} class="text-accent underline">
            {site.correo.direccion}
          </a>
        </span>
      </p>

      <button type="submit" class="btn btn-rojo btn-brillo js-pausable h-11 w-fit px-5! py-0! text-[15px]">
        <span class="js-boton-texto">{formulario.boton}</span>
        <svg class="flecha" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <p class="text-sm text-muted">{formulario.nota}</p>
    </form>

    {/* Confirmación: reemplaza al formulario al enviar bien */}
    <div class="js-exito mt-6 hidden" tabindex="-1">
      <div class="rounded-lg border border-line bg-base p-6">
        <h3 class="text-2xl">{formulario.exitoTitulo}</h3>
        <p class="mt-3 max-w-md leading-relaxed text-muted">
          {formulario.exitoTexto}
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Boton href={waLink} externo variante="outline" flecha={false} class="h-11 px-5! py-0! text-[15px]">
            Abrir WhatsApp
          </Boton>
        </div>
      </div>
    </div>
  </section>

  <Agenda conCalendario />

  <section class="reveal rounded-lg bg-raised p-6 md:p-7">
    <h2 class="text-xl font-medium">{ubicacion.titulo}</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{ubicacion.texto}</p>
  </section>
</Base>

<script>
  import { enviarFormulario } from "../scripts/envio";

  // Compatible con View Transitions: se vincula en cada carga de página.
  document.addEventListener("astro:page-load", iniciarFormularioContacto);

  function iniciarFormularioContacto() {

  const form = document.querySelector<HTMLFormElement>(".js-form-contacto");
  if (!form || form.dataset.listo === "1") return;
  form.dataset.listo = "1";

  form.addEventListener("submit", async (evento) => {
    evento.preventDefault();

    // Anti-spam: si el campo trampa está marcado, no se envía nada.
    const trampa = form.querySelector<HTMLInputElement>('[name="botcheck"]');
    if (trampa?.checked) return;

    // Validación con mensajes junto a cada campo.
    let primeroConError: HTMLElement | null = null;
    for (const campo of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      "input[required], textarea[required]",
    )) {
      const aviso = campo.parentElement?.querySelector<HTMLElement>("[data-error]");
      if (campo.value.trim() === "") {
        if (aviso) {
          aviso.textContent = "Este campo es obligatorio.";
          aviso.classList.remove("hidden");
        }
        campo.setAttribute("aria-invalid", "true");
        primeroConError ??= campo;
      } else {
        if (aviso) {
          aviso.textContent = "";
          aviso.classList.add("hidden");
        }
        campo.removeAttribute("aria-invalid");
      }
    }
    if (primeroConError) {
      primeroConError.focus();
      return;
    }

    const datos = new FormData(form);
    const campos: Record<string, string> = {
      subject: `Consulta desde la web — ${String(datos.get("Nombre") ?? "")}`,
      from_name: "Web NODO",
      Nombre: String(datos.get("Nombre") ?? ""),
      Rubro: String(datos.get("Rubro") ?? ""),
      Mensaje: String(datos.get("Mensaje") ?? ""),
    };

    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const botonTexto = form.querySelector<HTMLElement>(".js-boton-texto");
    const textoOriginal = botonTexto?.textContent ?? "";
    const errorEnvio = document.querySelector<HTMLElement>(".js-error-envio");
    errorEnvio?.classList.add("hidden");
    if (boton) {
      boton.disabled = true;
      boton.setAttribute("aria-busy", "true");
    }
    if (botonTexto) botonTexto.textContent = "Enviando…";

    const resultado = await enviarFormulario(campos);

    if (resultado.ok) {
      const exito = document.querySelector<HTMLElement>(".js-exito");
      form.hidden = true;
      exito?.classList.remove("hidden");
      exito?.focus({ preventScroll: true });
      exito?.scrollIntoView({ behavior: "smooth", block: "center" });
    } else {
      // Nada de lo escrito se pierde: el formulario queda como está.
      if (boton) {
        boton.disabled = false;
        boton.removeAttribute("aria-busy");
      }
      if (botonTexto) botonTexto.textContent = textoOriginal;
      errorEnvio?.classList.remove("hidden");
    }
  });
  }
</script>
