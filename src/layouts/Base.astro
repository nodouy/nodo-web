---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { ruta } from "../lib/rutas";

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = site.descripcion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={ruta("/favicon.svg")} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FAF8F5" />

    {/* Antes de pintar: marcar que hay JS y aplicar el tema guardado.
        El sitio abre en modo claro por defecto; la elección de la
        persona se recuerda entre visitas. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var t = null;
        try {
          t = localStorage.getItem("nodo-theme");
        } catch (e) {}
        d.dataset.theme = t === "light" || t === "dark" ? t : "light";
      })();
    </script>
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FJ0D00LM37"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FJ0D00LM37');

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var canal = a.href.includes('wa.me') ? 'whatsapp'
                  : a.href.startsWith('mailto:') ? 'email' : null;
        if (canal) gtag('event', 'contacto_click', {
          canal: canal, pagina: location.pathname
        });
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Aparición al scrollear. Los elementos están visibles por defecto;
      // solo se esconden si hay JS y el visitante no pidió reducir el
      // movimiento (ver global.css).
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("is-visible");
                io.unobserve(entrada.target);
                // Las grillas de puntos empiezan a respirar cuando su
                // cascada de entrada terminó.
                if (entrada.target.classList.contains("qs-grafica")) {
                  const objetivo = entrada.target;
                  setTimeout(() => objetivo.classList.add("qs-viva"), 1900);
                }
                entrada.target
                  .querySelectorAll(".mini-grilla")
                  .forEach((grilla) =>
                    setTimeout(() => grilla.classList.add("mg-viva"), 1200),
                  );
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -30px 0px" },
        );
        document
          .querySelectorAll(".reveal, .panel-anim, .qs-grafica")
          .forEach((el) => io.observe(el));

        // Los bucles (deriva del fondo, respiración de la grilla) se
        // pausan cuando salen de pantalla, para no gastar batería.
        const ioPausa = new IntersectionObserver((entradas) => {
          for (const entrada of entradas) {
            entrada.target.classList.toggle("fuera", !entrada.isIntersecting);
          }
        });
        document
          .querySelectorAll(".js-pausable")
          .forEach((el) => ioPausa.observe(el));
      } else {
        document
          .querySelectorAll(".reveal, .panel-anim, .qs-grafica")
          .forEach((el) => el.classList.add("is-visible"));
      }

      // Números que cuentan hasta su valor al entrar en pantalla.
      // Sin JS o con reduced-motion, el HTML ya trae el valor final.
      const contadores = document.querySelectorAll<HTMLElement>(".js-contador");
      if (contadores.length && !reduce && "IntersectionObserver" in window) {
        const formato = new Intl.NumberFormat("es-UY");
        const ioContador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              ioContador.unobserve(entrada.target);
              const el = entrada.target as HTMLElement;
              const valor = Number(el.dataset.valor ?? "0");
              const prefijo = el.dataset.prefijo ?? "";
              const sufijo = el.dataset.sufijo ?? "";
              const inicio = performance.now();
              const duracion = 900;
              const paso = (ahora: number) => {
                const avance = Math.min((ahora - inicio) / duracion, 1);
                const suave = 1 - Math.pow(1 - avance, 3);
                el.textContent =
                  prefijo + formato.format(Math.round(valor * suave)) + sufijo;
                if (avance < 1) requestAnimationFrame(paso);
              };
              requestAnimationFrame(paso);
            }
          },
          { threshold: 0.4 },
        );
        contadores.forEach((el) => ioContador.observe(el));
      }

      // Cambio de tema claro/oscuro.
      document.querySelectorAll(".js-theme").forEach((boton) => {
        boton.addEventListener("click", () => {
          const html = document.documentElement;
          const nuevo = html.dataset.theme === "light" ? "dark" : "light";
          html.dataset.theme = nuevo;
          try {
            localStorage.setItem("nodo-theme", nuevo);
          } catch (e) {}
        });
      });

      // Menú móvil.
      const toggle = document.querySelector(".js-nav-toggle");
      const menu = document.getElementById("menu-movil");
      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const abierto = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!abierto));
          toggle.setAttribute(
            "aria-label",
            abierto ? "Abrir el menú" : "Cerrar el menú",
          );
          menu.hidden = abierto;
        });
        menu.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
          }),
        );
      }
    </script>
  </body>
</html>
