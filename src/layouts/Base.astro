---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import BarraLateral from "../components/BarraLateral.astro";
import EncabezadoPagina from "../components/EncabezadoPagina.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { ruta } from "../lib/rutas";

interface Props {
  titulo: string;
  /** Nombre de la sección, en grande en el encabezado del reporte. */
  seccion: string;
  descripcion?: string;
  etiqueta?: string;
}

const { titulo, seccion, descripcion = site.descripcion, etiqueta } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={ruta("/favicon.svg")} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FAF8F5" />
    <ClientRouter />

    {/* Antes de pintar: marcar que hay JS y aplicar el tema guardado.
        El sitio abre en modo claro por defecto; la elección de la
        persona se recuerda entre visitas. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        var t = null;
        try {
          t = localStorage.getItem("nodo-theme");
        } catch (e) {}
        d.dataset.theme = t === "light" || t === "dark" ? t : "light";
      })();
    </script>
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FJ0D00LM37"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FJ0D00LM37');

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var canal = a.href.includes('wa.me') ? 'whatsapp'
                  : a.href.startsWith('mailto:') ? 'email' : null;
        if (canal) gtag('event', 'contacto_click', {
          canal: canal, pagina: location.pathname
        });
      });
    </script>
  </head>
  <body class="pb-20 md:pb-0">
    <div class="flex min-h-screen">
      <BarraLateral />
      <div class="flex min-h-screen min-w-0 flex-1 flex-col">
        <div class="flex flex-1 flex-col gap-5 px-5 pb-16 pt-7 md:px-10 md:pt-8">
          <EncabezadoPagina seccion={seccion} etiqueta={etiqueta} />
          <main class="flex flex-1 flex-col gap-5">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>

    <script>
      import "../scripts/grafico";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- Vínculos que viven una sola vez (sobreviven a las View
      // Transitions porque van sobre document/window) -----------------

      // Medición: los elementos marcados con data-ga disparan su evento
      // de GA4 al clic (cta_comenzar, agenda_click). El evento
      // contacto_click vive en el bloque de Analytics del <head> y no
      // se toca desde acá.
      document.addEventListener("click", (e) => {
        const objetivo = (e.target as Element).closest?.("[data-ga]");
        if (!objetivo) return;
        const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
        if (typeof w.gtag === "function") {
          w.gtag("event", (objetivo as HTMLElement).dataset.ga, {
            pagina: location.pathname,
          });
        }
      });

      // Con View Transitions la navegación no recarga la página, así
      // que el bloque de Analytics solo registra la primera vista. Las
      // siguientes se avisan acá, sin tocar ese bloque.
      let primeraCarga = true;

      // --- Inicialización por página (corre en la carga inicial y en
      // cada navegación con View Transitions) --------------------------
      function iniciarPagina() {
        if (!reduce && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entradas) => {
              for (const entrada of entradas) {
                if (entrada.isIntersecting) {
                  entrada.target.classList.add("is-visible");
                  io.unobserve(entrada.target);
                  if (entrada.target.classList.contains("qs-grafica")) {
                    const objetivo = entrada.target;
                    setTimeout(() => objetivo.classList.add("qs-viva"), 1900);
                  }
                  entrada.target
                    .querySelectorAll(".mini-grilla")
                    .forEach((grilla) =>
                      setTimeout(() => grilla.classList.add("mg-viva"), 1200),
                    );
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -30px 0px" },
          );
          document
            .querySelectorAll(".reveal, .panel-anim, .qs-grafica")
            .forEach((el) => io.observe(el));

          // Los bucles se pausan cuando salen de pantalla.
          const ioPausa = new IntersectionObserver((entradas) => {
            for (const entrada of entradas) {
              entrada.target.classList.toggle("fuera", !entrada.isIntersecting);
            }
          });
          document
            .querySelectorAll(".js-pausable")
            .forEach((el) => ioPausa.observe(el));
        } else {
          document
            .querySelectorAll(".reveal, .panel-anim, .qs-grafica")
            .forEach((el) => el.classList.add("is-visible"));
        }

        // Números que cuentan hasta su valor al entrar en pantalla.
        const contadores = document.querySelectorAll<HTMLElement>(".js-contador");
        if (contadores.length && !reduce && "IntersectionObserver" in window) {
          const formato = new Intl.NumberFormat("es-UY");
          const ioContador = new IntersectionObserver(
            (entradas) => {
              for (const entrada of entradas) {
                if (!entrada.isIntersecting) continue;
                ioContador.unobserve(entrada.target);
                const el = entrada.target as HTMLElement;
                const valor = Number(el.dataset.valor ?? "0");
                const prefijo = el.dataset.prefijo ?? "";
                const sufijo = el.dataset.sufijo ?? "";
                const inicio = performance.now();
                const duracion = 900;
                const paso = (ahora: number) => {
                  const avance = Math.min((ahora - inicio) / duracion, 1);
                  const suave = 1 - Math.pow(1 - avance, 3);
                  el.textContent =
                    prefijo + formato.format(Math.round(valor * suave)) + sufijo;
                  if (avance < 1) requestAnimationFrame(paso);
                };
                requestAnimationFrame(paso);
              }
            },
            { threshold: 0.4 },
          );
          contadores.forEach((el) => ioContador.observe(el));
        }

        // Cambio de tema claro/oscuro (botones nuevos en cada página).
        document.querySelectorAll(".js-theme").forEach((boton) => {
          boton.addEventListener("click", () => {
            const html = document.documentElement;
            const nuevo = html.dataset.theme === "light" ? "dark" : "light";
            html.dataset.theme = nuevo;
            try {
              localStorage.setItem("nodo-theme", nuevo);
            } catch (e) {}
          });
        });
      }

      document.addEventListener("astro:page-load", () => {
        iniciarPagina();
        if (primeraCarga) {
          primeraCarga = false;
          return;
        }
        const w = window as typeof window & { gtag?: (...args: unknown[]) => void };
        if (typeof w.gtag === "function") {
          w.gtag("event", "page_view", {
            page_location: location.href,
            page_title: document.title,
          });
        }
      });
    </script>
  </body>
</html>
